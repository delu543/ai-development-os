+import unittest
+from datetime import datetime, timedelta, timezone
+
+from agenda import entries
+
+
+class CalendarDayTests(unittest.TestCase):
+    def test_one_instant_has_one_day_across_offsets(self):
+        midnight = datetime(2026, 11, 25, tzinfo=timezone.utc)
+        samples = [(-1, False), (0, True), (1, True), (43200, True),
+                   (86399, True), (86400, False)]
+        for seconds, belongs in samples:
+            instant = midnight + timedelta(seconds=seconds)
+            for hours in (-11, -5, 0, 8, 14):
+                with self.subTest(seconds=seconds, offset=hours):
+                    stamp = instant.astimezone(timezone(timedelta(hours=hours))).isoformat()
+                    rows = [dict(id="event", start=stamp, cancelled=False)]
+                    self.assertEqual(entries("2026-11-25", rows), ["event"] if belongs else [])
+
+    def test_cancelled_event_is_filtered(self):
+        rows = [dict(id="cancel", start="2026-11-24T19:00:00-05:00", cancelled=True),
+                dict(id="keep", start="2026-11-25T00:00:00Z", cancelled=False)]
+        self.assertEqual(entries("2026-11-25", rows), ["keep"])
