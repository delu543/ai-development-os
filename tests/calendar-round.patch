+def utc_day(start):
+    if start.endswith("Z"):
+        start = start[:-1] + "+00:00"
+    instant = datetime.fromisoformat(start)
+    if instant.utcoffset() is None:
+        raise ValueError("An event start time must include a UTC offset")
+    return instant.astimezone(timezone.utc).date().isoformat()
 
 
